{
  "name": "raven",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build cli/src/main.ts --compile --outfile plugins/raven/dist/raven",
    "typecheck": "tsc -p plugins/raven && tsc -p cli",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "test": "bun test ./cli ./plugins/raven/tests/unit",
    "test:mod": "CLAUDE_CODE_ENABLE_FUNCTION_HOOKS=1 claude plugin test plugins/raven",
    "validate": "claude plugin validate . --strict && claude plugin validate plugins/raven --strict",
    "check": "bun run typecheck && bun run lint && bun run test && bun run test:mod && bun run validate",
    "types:sync": "cp plugins/raven/.claude-plugin/types/claude-code/index.d.ts types/claude-code.d.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "bun-types": "^1.3.11",
    "typescript": "^6.0.2"
  }
}
