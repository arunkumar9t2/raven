#!/bin/sh
# Resolve through symlinks so this works whether Claude Code invokes it via a plugin symlink or in
# place; the compiled binary and the dev checkout are found relative to this file, not to $PWD.
dir=$(dirname "$(readlink -f "$0")")

if [ -x "$dir/../dist/raven" ]; then
  exec "$dir/../dist/raven" "$@"
fi

if command -v bun >/dev/null 2>&1; then
  exec bun "$dir/../../../cli/src/main.ts" "$@"
fi

echo "raven is not built and bun is not on PATH; run \`bun run build\`" >&2
exit 127
