#!/bin/sh
# Resolve through symlinks so this works whether Claude Code invokes it via a plugin symlink or in
# place; the compiled binary, else the TypeScript source run by Bun, is found relative to this file.
dir=$(dirname "$(readlink -f "$0")")

if [ -x "$dir/../dist/raven" ]; then
  exec "$dir/../dist/raven" "$@"
fi

if command -v bun >/dev/null 2>&1; then
  exec bun "$dir/../cli/src/main.ts" "$@"
fi

echo "raven needs Bun on PATH (https://bun.sh), or a build: bun run build" >&2
exit 127
